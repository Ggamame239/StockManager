# Local Vite dev-server targets only; set the non-VITE server variables on Vercel.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_PO_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_PO_DEPLOYMENT_ID/exec
# Server-only Apps Script targets used by Vercel Functions.
STOCK_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_STOCK_DEPLOYMENT_ID/exec
PO_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_PO_DEPLOYMENT_ID/exec
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id